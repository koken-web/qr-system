rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function devicePath(uid) {
      return /databases/$(database)/documents/system/device-access/devices/$(uid);
    }

    function configPath() {
      return /databases/$(database)/documents/system/device-access;
    }

    function currentDeviceExists() {
      return signedIn() && exists(devicePath(currentUid()));
    }

    function currentDevice() {
      return get(devicePath(currentUid())).data;
    }

    function activeDevice() {
      return currentDeviceExists() && currentDevice().active == true;
    }

    function memberDevice() {
      return activeDevice()
        && (currentDevice().role == 'member' || currentDevice().role == 'control');
    }

    function receptionDevice() {
      return activeDevice() && currentDevice().role == 'reception';
    }

    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    function validRole(value) {
      return value == 'member'
        || value == 'reception'
        || value == 'control';
    }

    function validRequestType(value) {
      return value == 'initial' || value == 'upgrade';
    }

    function validDeviceType(value) {
      return value in [
        'ipad', 'iphone', 'android', 'windows', 'mac', 'other', 'unknown'
      ];
    }

    function validDevice(data) {
      return data.keys().hasAll([
          'role', 'displayName', 'deviceName', 'active', 'createdAt',
          'approvedAt', 'approvedByUid', 'approvedByName'
        ])
        && data.keys().hasOnly([
          'role', 'displayName', 'deviceName', 'deviceType', 'active', 'createdAt',
          'approvedAt', 'approvedByUid', 'approvedByName', 'disabledAt',
          'disabledByUid', 'disabledByName'
        ])
        && validRole(data.role)
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && (!('deviceType' in data) || validDeviceType(data.deviceType))
        && data.active is bool
        && data.createdAt is timestamp
        && data.approvedAt is timestamp
        && data.approvedByUid is string
        && data.approvedByName is string
        && (!('disabledAt' in data) || data.disabledAt is timestamp)
        && (!('disabledByUid' in data) || data.disabledByUid is string)
        && (!('disabledByName' in data) || data.disabledByName is string);
    }

    function validPendingRequest(data, uid) {
      return signedIn()
        && uid == currentUid()
        && data.keys().hasOnly([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid',
          'decidedByName', 'pairingCode', 'pairingExpiresAt'
        ])
        && data.keys().hasAll([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid',
          'decidedByName'
        ])
        && validRequestType(data.requestType)
        && validRole(data.requestedRole)
        && data.requestedRole != 'control'
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && validDeviceType(data.deviceType)
        && data.status == 'pending'
        && data.requestedAt == request.time
        && data.decidedAt == null
        && data.decidedByUid == ''
        && data.decidedByName == ''
        && (
          (
            !('pairingCode' in data)
            && !('pairingExpiresAt' in data)
          )
          ||
          (
            data.pairingCode is string
            && data.pairingCode.matches('^[A-HJ-NP-Z2-9]{8}$')
            && data.pairingExpiresAt is timestamp
            && data.pairingExpiresAt > request.time
            && data.pairingExpiresAt <= request.time + duration.value(15, 'm')
            && data.requestType == 'initial'
            && data.requestedRole == 'member'
          )
        )
        && (
          (
            data.requestType == 'initial'
            && (!currentDeviceExists() || currentDevice().active != true)
          )
          ||
          (
            data.requestType == 'upgrade'
            && receptionDevice()
            && data.requestedRole == 'member'
          )
        );
    }

    function validDecision(data) {
      return resource.data.status == 'pending'
        && (!('pairingExpiresAt' in resource.data)
          || resource.data.pairingExpiresAt > request.time)
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decidedAt', 'decidedByUid', 'decidedByName'
        ])
        && (data.status == 'approved' || data.status == 'rejected')
        && data.decidedAt == request.time
        && data.decidedByUid == currentUid()
        && data.decidedByName == currentDevice().displayName;
    }

    function validAudit(data) {
      return data.keys().hasOnly([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.keys().hasAll([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.action in [
          'bootstrap-member', 'request-created', 'request-approved',
          'request-rejected', 'device-disabled', 'device-renamed',
          'device-deleted'
        ]
        && data.actorUid is string
        && shortText(data.actorName)
        && data.targetUid is string
        && shortText(data.targetName)
        && (data.role == null || validRole(data.role))
        && data.createdAt == request.time;
    }

    function validReceptionStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastReceptionAt', 'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberCreate(memberId) {
      return request.resource.data.keys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberUpdate(memberId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validScannerActivity(activityId) {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'qrNumber', 'timestamp', 'isReEntry', 'source',
          'offline', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'type', 'qrNumber', 'timestamp', 'source', 'createdAt'
        ])
        && request.resource.data.id == activityId
        && request.resource.data.type in [
          'ticket-entry', 'ticket-exit', 'member-entry', 'member-exit'
        ]
        && request.resource.data.qrNumber is string
        && request.resource.data.timestamp is string
        && request.resource.data.source == 'scanner'
        && (!('isReEntry' in request.resource.data)
          || request.resource.data.isReEntry is bool)
        && (!('offline' in request.resource.data)
          || request.resource.data.offline is bool)
        && request.resource.data.createdAt == request.time;
    }

    function validReceptionEvent(eventId) {
      return request.resource.data.keys().hasOnly([
          'id', 'eventId', 'subjectType', 'ticketId', 'memberId', 'qrNumber',
          'type', 'timestamp', 'deviceId', 'offline', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'eventId', 'subjectType', 'qrNumber', 'type',
          'timestamp', 'deviceId', 'offline', 'createdAt'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.eventId is string
        && request.resource.data.subjectType in ['ticket', 'member']
        && request.resource.data.qrNumber is string
        && request.resource.data.type in ['entry', 'exit']
        && request.resource.data.timestamp is string
        && request.resource.data.deviceId is string
        && request.resource.data.offline is bool
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.subjectType == 'ticket'
            && 'ticketId' in request.resource.data
            && request.resource.data.ticketId is string
            && request.resource.data.ticketId.size() > 0
            && !('memberId' in request.resource.data)
          )
          ||
          (
            request.resource.data.subjectType == 'member'
            && 'memberId' in request.resource.data
            && request.resource.data.memberId is string
            && request.resource.data.memberId.size() > 0
            && !('ticketId' in request.resource.data)
          )
        );
    }

    function validAnalyticsSummary(summaryId) {
      return summaryId == 'summary'
        && request.resource.data.schemaVersion == 2
        && (request.resource.data.revision is int
          || request.resource.data.revision is float)
        && request.resource.data.revision >= 0
        && request.resource.data.needsRebuild is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionPresence(deviceId) {
      return request.resource.data.keys().hasOnly([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'receptionPaused', 'firebaseLatencyMs',
          'downloadMbps', 'networkMeasuredAt', 'screen', 'viewState', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'screen', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.registeredDeviceId == currentUid()
        && request.resource.data.deviceName == currentDevice().deviceName
        && (
          !('deviceType' in currentDevice())
          || request.resource.data.deviceType == currentDevice().deviceType
        )
        && request.resource.data.role == currentDevice().role
        && request.resource.data.mode in ['entry', 'exit']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() > 0
        && request.resource.data.appVersion.size() <= 20
        && (request.resource.data.lastSeenAt is int
          || request.resource.data.lastSeenAt is float)
        && request.resource.data.lastSuccessfulSyncAt == request.time
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 0
        && request.resource.data.cameraState in ['starting', 'ready', 'error']
        && (!('receptionPaused' in request.resource.data)
          || request.resource.data.receptionPaused is bool)
        && (!('firebaseLatencyMs' in request.resource.data)
          || (
            request.resource.data.firebaseLatencyMs is int
            && request.resource.data.firebaseLatencyMs >= 0
            && request.resource.data.firebaseLatencyMs <= 120000
          ))
        && (!('downloadMbps' in request.resource.data)
          || (
            (request.resource.data.downloadMbps is int
              || request.resource.data.downloadMbps is float)
            && request.resource.data.downloadMbps >= 0
            && request.resource.data.downloadMbps <= 10000
          ))
        && (!('networkMeasuredAt' in request.resource.data)
          || (
            request.resource.data.networkMeasuredAt is string
            && request.resource.data.networkMeasuredAt.size() <= 60
          ))
        && request.resource.data.screen in ['entry-reception', 'exit-reception']
        && (!('viewState' in request.resource.data)
          || request.resource.data.viewState in [
            'waiting', 'processing', 'success-animation',
            'ticket-success', 'member-success', 'error'
          ])
        && request.resource.data.sessionStartedAt is string
        && request.resource.data.sessionStartedAt.size() <= 60
        && request.resource.data.lastScanAt is string
        && request.resource.data.lastScanAt.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    function validRemoteCommandType(value) {
      return value in [
        'pause-reception', 'resume-reception', 'restart-camera',
        'sync-pending', 'play-sound', 'reload-app'
      ];
    }

    function validRemoteCommandCreate(data) {
      return data.keys().hasOnly([
          'type', 'status', 'issuedByUid', 'issuedByName', 'createdAt',
          'expiresAt', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && data.keys().hasAll([
          'type', 'status', 'issuedByUid', 'issuedByName', 'createdAt',
          'expiresAt', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && validRemoteCommandType(data.type)
        && data.status == 'pending'
        && data.issuedByUid == currentUid()
        && shortText(data.issuedByName)
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(1, 'm')
        && data.receivedAt == null
        && data.completedAt == null
        && data.updatedAt == request.time
        && data.errorMessage == '';
    }

    function ownsReceptionPresence(eventId, deviceId) {
      return activeDevice()
        && exists(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId))
        && get(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId)).data.registeredDeviceId == currentUid();
    }

    function validRemoteCommandUpdate(data) {
      return data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && data.type == resource.data.type
        && data.issuedByUid == resource.data.issuedByUid
        && data.issuedByName == resource.data.issuedByName
        && data.createdAt == resource.data.createdAt
        && data.expiresAt == resource.data.expiresAt
        && data.updatedAt == request.time
        && data.errorMessage is string
        && data.errorMessage.size() <= 160
        && (
          (
            resource.data.status == 'pending'
            && data.status == 'received'
            && data.receivedAt == request.time
            && data.completedAt == null
            && data.errorMessage == ''
          )
          ||
          (
            resource.data.status == 'pending'
            && data.status == 'failed'
            && data.receivedAt == null
            && data.completedAt == request.time
          )
          ||
          (
            resource.data.status == 'received'
            && data.status in ['completed', 'failed']
            && data.receivedAt == resource.data.receivedAt
            && data.completedAt == request.time
          )
        );
    }

    match /authorized-users/{document=**} {
      allow read, write: if false;
    }

    match /system/device-access {
      allow read: if signedIn();
      allow write: if false;
    }

    match /system/device-access/devices/{uid} {
      allow read: if signedIn();
      allow create: if currentUid() == uid
        && validDevice(request.resource.data);
      allow update: if (
          (currentUid() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deviceName'
          ]) && shortText(request.resource.data.deviceName))
          ||
          (memberDevice() && validDevice(request.resource.data))
        );
      allow delete: if memberDevice() || currentUid() == uid;
    }

    match /system/device-access/requests/{uid} {
      allow read: if currentUid() == uid || memberDevice();
      allow create: if validPendingRequest(request.resource.data, uid);
      allow update: if memberDevice() && validDecision(request.resource.data);
      allow delete: if currentUid() == uid || memberDevice();
    }

    match /system/device-access/audit/{auditId} {
      allow read: if memberDevice();
      allow create: if memberDevice() && validAudit(request.resource.data);
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if memberDevice();
      allow delete: if memberDevice();
    }

    match /event-data/{eventId}/{document=**} {
      allow read: if signedIn();
      allow write: if memberDevice();
    }

    match /event-data/{eventId}/receptionEvents/{receptionEventId} {
      allow read: if memberDevice() || receptionDevice();
      allow create: if memberDevice()
        || (receptionDevice() && validReceptionEvent(receptionEventId));
      allow update, delete: if memberDevice();
    }

    match /event-data/{eventId}/reception-devices/{deviceId} {
      allow read: if memberDevice() || receptionDevice();
      allow create, update: if receptionDevice()
        && ownsReceptionPresence(eventId, deviceId)
        && validReceptionPresence(deviceId);
      allow delete: if receptionDevice()
        && ownsReceptionPresence(eventId, deviceId);
    }

    match /event-data/{eventId}/reception-devices/{deviceId}/commands/{commandId} {
      allow read: if memberDevice() || receptionDevice();
      allow create: if memberDevice()
        && validRemoteCommandCreate(request.resource.data);
      allow update: if receptionDevice()
        && ownsReceptionPresence(eventId, deviceId)
        && validRemoteCommandUpdate(request.resource.data);
      allow delete: if memberDevice();
    }

    match /system/current-event {
      allow read: if signedIn();
      allow write: if memberDevice();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
